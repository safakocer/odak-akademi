# Sunucu güvenlik ve önbellek başlıkları (S26). Netlify ve Cloudflare Pages bu dosyayı okur; GitHub Pages okumaz.
# Bu dosyayı proje ana klasöründe (index.html'in yanında) bırak. Adı alt çizgiyle başlar, uzantısı yoktur.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Service worker ve sayfa her açılışta sunucuya sorulur; böylece yeni sürüm gecikmeden fark edilir
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
